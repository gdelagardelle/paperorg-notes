          "stringUnit": {
            "state": "translated",
            "value": "Beim Transkribieren wird Ihr Audio zur Verarbeitung an %1$@ gesendet. Lesen Sie die Datenschutzerklärung des Anbieters, bevor Sie fortfahren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous lancez la transcription, votre audio est envoyé à %1$@ pour traitement. Consultez sa politique de confidentialité avant de continuer."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann Dir transkribéiert, gëtt Är Audiodatei fir d'Veraarbechtung un %1$@ geschéckt. Liest d'Dateschutzerklärung vum Provider, ier Dir weiderfuert."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao transcrever, o seu áudio será enviado para %1$@ para processamento. Consulte a política de privacidade do fornecedor antes de continuar."
          }
        }
      }
    },
