    "Could not reach the server — will retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach the server — will retry"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server ist nicht erreichbar — erneuter Versuch folgt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre le serveur — nouvelle tentative à venir"
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "De Server konnt net erreecht ginn — et gëtt nach eng Kéier probéiert"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível contactar o servidor — será feita nova tentativa"
          }
        }
