    "Drag the handles to keep only the part you want. Transcription will use the trimmed audio if you reprocess.": {
      "comment": "A description of the audio trimming process.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the handles to keep only the part you want. Transcription will use the trimmed audio if you reprocess."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie die Griffe, um nur den gewünschten Teil zu behalten. Bei einer erneuten Verarbeitung wird das gekürzte Audio transkribiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les poignées pour ne conserver que la partie souhaitée. Si vous relancez le traitement, l’audio découpé sera utilisé pour la transcription."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Zitt d'Grëffer, fir nëmmen deen Deel ze behalen, deen Dir wëllt. Wann Dir d'Opnam nei veraarbecht, gëtt déi gekierzt Audiodatei fir d'Transkriptioun benotzt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste as pegas para manter apenas a parte pretendida. Se voltar a processar, a transcrição utilizará o áudio recortado."
          }
        }
      }
    },
