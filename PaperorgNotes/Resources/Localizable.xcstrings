    "privacy.intro": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Paperorg Notes zeichnet Audio auf Ihrem Gerät auf. Free umfasst 30 Minuten Cloud-Transkription und KI-Zusammenfassungen pro Monat, ohne API-Schlüssel und ohne Anmeldung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paperorg Notes records audio on your device. Free includes 30 minutes of cloud transcription and AI summaries each month, with no API keys or sign-in required."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paperorg Notes enregistre l’audio sur votre appareil. L’offre gratuite comprend 30 minutes mensuelles de transcription cloud et de résumés IA, sans clé API ni inscription."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Paperorg Notes registréiert Audio op Ärem Apparat. Free enthält all Mount 30 Minutte Cloud-Transkriptioun an AI-Zesummefaassungen, ouni API-Schlësselen an ouni Umeldung."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Paperorg Notes grava áudio no seu dispositivo. O plano gratuito inclui 30 minutos mensais de transcrição na cloud e resumos de IA, sem chaves API nem registo."
          }
        }
      }
    },
    "privacy.provider_hint": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-Transkription sendet Audio sicher an Paperorg und die für Ihre Anfrage erforderlichen KI-Dienstleister. Paperorg verwahrt die Anbieter-Zugangsdaten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud transcription securely sends audio to Paperorg and the AI processors needed for your request. Paperorg holds the provider credentials."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription cloud envoie l’audio de manière sécurisée à Paperorg et aux prestataires IA nécessaires à votre demande. Paperorg conserve les identifiants des prestataires."
          }
        },
        "lb": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-Transkriptioun schéckt Audio sécher un Paperorg an d'AI-Provider déi fir Är Ufro néideg sinn. Paperorg hält d'Provider-Zougangsdaten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição na cloud envia o áudio de forma segura para a Paperorg e para os processadores de IA necessários ao seu pedido. A Paperorg guarda as credenciais dos fornecedores."
          }
        }
      }
    },
